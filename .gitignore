# 运行时产物与本地环境，不进仓库
.env
.env.*
.tmp/
*.log
# sidecar 运行时落盘的报告目录（示例报告见仓库根目录 reports/）
starter/sidecar/reports/
# 例外：docs/proof 下的日志是实证证据，必须入库（否则别人拉下来守门就失败）
!docs/proof/*.log

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
starter/sidecar/.cache/

# Node / 插件构建产物
node_modules/
starter/dsh-plugin/dist/

# Agent 工具状态
.workbuddy/
