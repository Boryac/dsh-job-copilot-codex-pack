      "desc": "面试题不少于 8 道且每题带 evidence_ref",
      "check": {
        "type": "min_questions",
        "value": 8
      }
    },
    {
      "id": "P3",
      "desc": "至少一题围绕 SQL / 数据分析能力追问",
      "check": {
        "type": "question_mentions",
        "values": [
          "SQL",
          "数据"
        ]
